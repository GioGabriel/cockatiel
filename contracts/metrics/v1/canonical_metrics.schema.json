{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/metrics/v1/canonical_metrics.schema.json",
  "title": "CanonicalVocalMetricsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pitch_accuracy",
    "timing_accuracy",
    "breath_control",
    "pitch_stability",
    "vibrato_consistency",
    "note_transition_smoothness",
    "exercise_type",
    "session_id",
    "timestamp_ms"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "exercise_type": { "type": "string", "minLength": 1 },
    "pitch_accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
    "timing_accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
    "breath_control": { "type": "number", "minimum": 0, "maximum": 100 },
    "pitch_stability": { "type": "number", "minimum": 0, "maximum": 100 },
    "vibrato_consistency": { "type": "number", "minimum": 0, "maximum": 100 },
    "note_transition_smoothness": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
